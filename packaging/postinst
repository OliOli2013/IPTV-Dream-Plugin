#!/bin/sh
set -e

PLUGIN_DIR="/usr/lib/enigma2/python/Plugins/Extensions/IPTVDream"

if [ -d "$PLUGIN_DIR" ]; then
    rm -f \
        "$PLUGIN_DIR/dream.py" "$PLUGIN_DIR/dream_v2.py" "$PLUGIN_DIR/export.py" \
        "$PLUGIN_DIR/test_plugin.py" "$PLUGIN_DIR/tools/epg_picon_fixed.py" \
        "$PLUGIN_DIR/tools/mac_portal_v6.py" "$PLUGIN_DIR/tools/picon_manager.py" \
        "$PLUGIN_DIR/tools/xtream_one_window.py" "$PLUGIN_DIR/tools/vkb_input.py" \
        "$PLUGIN_DIR/pic/iptvdream_mark.png" 2>/dev/null || true
    rm -rf \
        "$PLUGIN_DIR/__pycache__" "$PLUGIN_DIR/core/__pycache__" \
        "$PLUGIN_DIR/tools/__pycache__" 2>/dev/null || true
    find "$PLUGIN_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
    find "$PLUGIN_DIR" -type f -name '*.py' -exec chmod 755 {} \; 2>/dev/null || true
fi

exit 0
